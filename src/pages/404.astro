---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Không tìm thấy trang"
  description="Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển."
>
  <section class="section not-found-section">
    <div class="container not-found-container">
      <div class="not-found-card">
        <div class="error-badge font-mono">ERR_404_PAGE_NOT_FOUND</div>
        <h1 class="error-title">404</h1>
        <h2 class="error-subtitle">Không Tìm Thấy Trang Yêu Cầu</h2>
        <p class="error-desc">
          Đường dẫn bạn vừa truy cập không tồn tại trên hệ thống hoặc đã được cấu trúc lại trong phiên bản mới.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Quay về trang chủ
          </a>
          <a href="/projects" class="btn btn-secondary">
            Xem danh mục dự án
          </a>
          <a href="/courses" class="btn btn-outline">
            Xem các khóa học
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .not-found-container {
    max-width: 600px;
    text-align: center;
  }

  .not-found-card {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 3.5rem 2rem;
    box-shadow: var(--shadow-md);
  }

  .error-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background-color: #fee2e2;
    color: #b91c1c;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }

  .error-title {
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-family: var(--font-mono);
    color: var(--color-navy);
    line-height: 1;
    margin-bottom: 0.5rem;
    letter-spacing: -0.04em;
  }

  .error-subtitle {
    font-size: 1.35rem;
    margin-bottom: 1rem;
    color: var(--color-navy);
  }

  .error-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
