---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../data/siteConfig';

// Fetch the about page markdown entry
const aboutEntries = await getCollection('about');
const aboutData = aboutEntries[0];

// Fallback if not yet created
const title = aboutData?.data.title || 'Về Tôi — Thầy Giang Tự Động Hóa';
const description =
  aboutData?.data.description ||
  'Hành trình cá nhân của Thầy Giang (Hoài Giang) — Kỹ sư Embedded Systems, PCB & Tự động hóa công nghiệp.';
const subtitle =
  aboutData?.data.subtitle ||
  'Kỹ sư Thiết kế Hệ thống Nhúng & Giảng viên Đào tạo Kỹ thuật Thực chiến với hơn 8 năm kinh nghiệm chế tạo và vận hành thiết bị thực tế.';
const cover = aboutData?.data.cover || '/media/team-lab.webp';
const stats = aboutData?.data.stats || [];

// Render markdown body
let ContentComponent = null;
if (aboutData) {
  const rendered = await render(aboutData);
  ContentComponent = rendered.Content;
}
---

<BaseLayout title="Về tôi" description={description} image={cover}>
  <!-- Page Header -->
  <div class="about-page-header">
    <div class="container">
      <span class="section-tag">Hành trình &amp; Năng lực</span>
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">{subtitle}</p>
    </div>
  </div>

  <!-- Key Metrics / Stats Section -->
  {stats && stats.length > 0 && (
    <section class="about-stats-section">
      <div class="container">
        <div class="stats-grid">
          {stats.map((item) => (
            <div class="stat-card">
              <span class="stat-number font-mono">{item.number}</span>
              <span class="stat-label">{item.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Featured Visual Grid (Real Portrait + Lab Workbench) -->
  <div class="container about-cover-container">
    <div class="about-hero-grid">
      <div class="about-portrait-card">
        <div class="portrait-img-wrap">
          <img
            src="/media/author-portrait.webp"
            alt="Thầy Giang — Kỹ sư Embedded Systems & Tự động hóa"
            class="about-portrait-img"
            onerror="this.src='/media/author-portrait.jpg'"
          />
        </div>
        <div class="portrait-meta-badge">
          <span class="portrait-name">{siteConfig.authorName}</span>
          <span class="portrait-title font-mono">{siteConfig.brandSubname}</span>
          <span class="portrait-subtitle">Kỹ sư Nhúng &amp; Đào tạo</span>
        </div>
      </div>
      <div class="about-cover-card">
        <img
          src={cover}
          alt="Thầy Giang làm việc tại phòng Lab Điện tử & Tự động hóa"
          class="about-cover-img"
          onerror="this.src='/media/team-lab.jpg'"
        />
        <div class="cover-caption">
          <span>Phòng Lab R&amp;D Phần Cứng &amp; Thực Hành Nhúng Thực Tế</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Markdown Content Section -->
  <section class="section">
    <div class="container about-content-container">
      <div class="prose about-prose">
        {ContentComponent ? (
          <ContentComponent />
        ) : (
          <p>Nội dung đang được cập nhật...</p>
        )}
      </div>

      <!-- Bottom Navigation / CTA Box -->
      <div class="about-bottom-cta">
        <div class="cta-text">
          <h3>Bạn Cần Trao Đổi Về Giải Pháp Kỹ Thuật Hoặc Tư Vấn Khóa Học?</h3>
          <p>
            Tôi luôn sẵn sàng lắng nghe, tư vấn định hướng chuyên môn và đồng hành hiện thực hóa dự án thực tế cùng bạn.
          </p>
        </div>
        <div class="cta-buttons">
          <a href="/contact" class="btn btn-primary">Liên hệ trực tiếp</a>
          <a href="/projects" class="btn btn-secondary">Xem các dự án</a>
          <a href="/courses" class="btn btn-outline">Xem các khóa học</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page-header {
    background: linear-gradient(180deg, #f1f5f9 0%, #f8fafc 100%);
    border-bottom: 1px solid var(--border-subtle);
    padding: 3.5rem 0 2.5rem;
    text-align: center;
  }

  .page-title {
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .about-stats-section {
    padding: 2rem 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-subtle);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 820px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.25rem 1rem;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface-alt);
    border: 1px solid var(--border-subtle);
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .about-cover-container {
    margin-top: 3rem;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 1.75rem;
    align-items: stretch;
  }

  @media (max-width: 860px) {
    .about-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .about-portrait-card {
    background-color: #ffffff;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-md);
  }

  .portrait-img-wrap {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #0f172a;
  }

  .about-portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .portrait-meta-badge {
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    text-align: center;
  }

  .portrait-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
  }

  .portrait-title {
    font-size: 0.85rem;
    color: var(--color-primary);
    font-weight: 700;
    margin-top: 0.15rem;
  }

  .portrait-subtitle {
    font-size: 0.78rem;
    color: var(--text-subtle);
    margin-top: 0.25rem;
  }

  .about-cover-card {
    background-color: #0f172a;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-md);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .about-cover-img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    display: block;
    background-color: #090d16;
  }

  .cover-caption {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: #cbd5e1;
    padding: 0.65rem 1rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .about-content-container {
    max-width: 860px;
  }

  .about-prose {
    margin-top: 1rem;
  }

  .about-bottom-cta {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    border-radius: var(--radius-lg);
    padding: 2.75rem;
    margin-top: 4rem;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .cta-text h3 {
    color: #ffffff;
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .cta-text p {
    color: #94a3b8;
    font-size: 0.95rem;
    max-width: 620px;
    margin: 0 auto;
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
