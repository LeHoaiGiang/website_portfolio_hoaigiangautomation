---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/siteConfig';

// Fetch published projects, courses, and blog posts
const allProjects = await getCollection('projects', ({ data }) => data.published === true);
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

const allCourses = await getCollection('courses', ({ data }) => data.published === true);
const featuredCourses = allCourses
  .filter((c) => c.data.featured)
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

const allPosts = await getCollection('blog', ({ data }) => data.published === true);
const latestPosts = allPosts
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 3);

// Core Technical Domains
const technicalDomains = [
  {
    title: 'Embedded Systems',
    chip: 'STM32 / ARM',
    desc: 'Lập trình firmware C/C++, ngoại vi thanh ghi, FreeRTOS và bus truyền thông công nghiệp CAN-Bus, RS-485.',
    icon: 'cpu',
  },
  {
    title: 'IoT & Telemetry',
    chip: 'ESP32 / Cloud',
    desc: 'Hệ thống thu thập dữ liệu IoT, bảo mật TLS 1.3, giao thức MQTT, HTTP REST, OTA update và Dashboard giám sát.',
    icon: 'wifi',
  },
  {
    title: 'FPGA & Verilog',
    chip: 'Cyclone / Artix',
    desc: 'Thiết kế logic số song song tốc độ cao, điều khiển động cơ FOC, thuật toán SVPWM và giao tiếp bộ nhớ.',
    icon: 'grid',
  },
  {
    title: 'Thiết Kế Bo Mạch PCB',
    chip: 'KiCad / Altium',
    desc: 'Vẽ mạch nguyên lý Schematic, Layout PCB 2-4 lớp, phối hợp trở kháng và tối ưu chuẩn tương thích điện từ EMC/EMI.',
    icon: 'layers',
  },
  {
    title: 'PLC & Tự Động Hóa',
    chip: 'Siemens / Modbus',
    desc: 'Lập trình PLC Siemens S7-1200/1500, biến tần, màn hình HMI và tích hợp mạng truyền thông SCADA công xưởng.',
    icon: 'settings',
  },
  {
    title: 'Qt / C++ & Tooling',
    chip: 'Desktop Apps',
    desc: 'Phần mềm máy tính giám sát thông số phần cứng, phân tích dữ liệu cổng COM/UART và công cụ kiểm thử thiết bị.',
    icon: 'terminal',
  },
];
---

<BaseLayout
  title="Trang chủ"
  description="Hoài Giang Automation — Học thiết kế bo mạch & lập trình nhúng theo quy trình chuẩn công nghiệp cùng Thầy Giang. Khóa học thực chiến STM32, ESP32, PCB và Tự động hóa."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <!-- Brand Tagline Badge -->
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span class="hero-badge-text">Đào tạo kỹ thuật thực chiến · Thiết kế bo mạch &amp; Hệ thống nhúng</span>
        </div>

        <h1 class="hero-title">
          Học thiết kế bo mạch &amp; lập trình nhúng theo <span class="gradient-text">chuẩn công nghiệp</span>
        </h1>

        <p class="hero-description">
          Đồng hành cùng <strong>Thầy Giang</strong> ({siteConfig.brandSubname}). Lộ trình thực chiến từ người chưa biết đọc schematic đến tự tay làm chủ bo mạch PCB 4 lớp, lập trình STM32/ESP32 FreeRTOS và chuyển giao hệ thống công nghiệp ổn định 24/7.
        </p>

        <!-- CTA Buttons (Value & Conversion Oriented) -->
        <div class="hero-actions">
          <a href="/courses" class="btn btn-primary">
            <span>Khám phá khóa học thực chiến</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/projects" class="btn btn-secondary">
            <span>Xem dự án đã hoàn thành</span>
          </a>
          <a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-youtube-action">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#ffffff"/>
            </svg>
            <span>120+ Video bài giảng</span>
          </a>
        </div>

        <!-- Tech Quick Stats (Verified & Credible) -->
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">8+ Năm</span>
            <span class="stat-label">Kinh nghiệm phần cứng &amp; nhúng</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">500+</span>
            <span class="stat-label">Học viên &amp; Kỹ sư theo học</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">120+</span>
            <span class="stat-label">Video bài giảng trên YouTube</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">30+</span>
            <span class="stat-label">Bo mạch &amp; Dự án đã bàn giao</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Card -->
      <div class="hero-visual">
        <div class="visual-panel">
          <div class="panel-header">
            <div class="panel-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="panel-title font-mono">system_status.log</span>
            <span class="badge badge-emerald">Online</span>
          </div>
          <div class="panel-body font-mono">
            <div class="log-line"><span class="log-prompt">$</span> init_system --brand="Hoài Giang Automation"</div>
            <div class="log-line success"><span class="log-tag">[OK]</span> STM32 ARM Cortex-M4 initialized @ 168MHz</div>
            <div class="log-line success"><span class="log-tag">[OK]</span> ESP32-S3 Wi-Fi &amp; MQTT TLS connected</div>
            <div class="log-line success"><span class="log-tag">[OK]</span> FPGA Cyclone IV FOC motor loop: &lt;1µs</div>
            <div class="log-line success"><span class="log-tag">[OK]</span> Modbus RS-485 bus: 32 nodes healthy</div>
            <div class="log-line info"><span class="log-tag">[INFO]</span> Ready for industrial deployment &amp; lab training</div>
            <div class="log-line blink-line"><span class="log-prompt">&gt;</span> <span class="cursor">_</span></div>
          </div>
          <div class="panel-footer">
            <div class="panel-spec">
              <span class="spec-name">MCU / SOC:</span>
              <span class="spec-data font-mono">STM32 / ESP32</span>
            </div>
            <div class="panel-spec">
              <span class="spec-name">BUS:</span>
              <span class="spec-data font-mono">CAN / RS485</span>
            </div>
            <div class="panel-spec">
              <span class="spec-name">STACK:</span>
              <span class="spec-data font-mono">FreeRTOS / LwIP</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technology Ecosystem Trust Strip -->
  <div class="trust-bar">
    <div class="container trust-container">
      <span class="trust-label">Nền tảng &amp; Tiêu chuẩn đào tạo:</span>
      <div class="trust-badges">
        <span class="trust-item"><span class="trust-dot"></span>STM32 ARM Cortex</span>
        <span class="trust-item"><span class="trust-dot"></span>ESP32 IoT Cloud</span>
        <span class="trust-item"><span class="trust-dot"></span>Altium &amp; KiCad EDA</span>
        <span class="trust-item"><span class="trust-dot"></span>FreeRTOS Kernel</span>
        <span class="trust-item"><span class="trust-dot"></span>Siemens S7 PLC</span>
        <span class="trust-item"><span class="trust-dot"></span>Modbus &amp; CAN-Bus</span>
      </div>
    </div>
  </div>

  <!-- Technical Domains Section -->
  <section class="section domains-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Năng lực cốt lõi</span>
        <h2 class="section-title">Lĩnh Vực Chuyên Môn Kỹ Thuật</h2>
        <p class="section-desc">
          Kết hợp hài hòa giữa thiết kế phần cứng điện tử chuẩn công nghiệp và kỹ thuật viết firmware/phần mềm tối ưu.
        </p>
      </div>

      <div class="grid-3">
        {technicalDomains.map((domain) => (
          <div class="card domain-card">
            <div class="domain-header">
              <div class="domain-chip font-mono">{domain.chip}</div>
            </div>
            <h3 class="domain-title">{domain.title}</h3>
            <p class="domain-desc">{domain.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="section bg-surface-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Sản phẩm thực tế</span>
        <h2 class="section-title">Dự Án Kỹ Thuật Nổi Bật</h2>
        <p class="section-desc">
          Các dự án tiêu biểu được thiết kế, gia công bo mạch và lập trình hoàn thiện với thông số kỹ thuật rõ ràng.
        </p>
      </div>

      {featuredProjects.length > 0 ? (
        <div class="grid-2">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Chưa có dự án nào được đánh dấu nổi bật.</p>
        </div>
      )}

      <div class="section-footer-cta">
        <a href="/projects" class="btn btn-secondary">
          <span>Xem tất cả {allProjects.length} dự án kỹ thuật</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Courses Section (STRICTLY NO PRICE) -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Đào tạo chuyên sâu</span>
        <h2 class="section-title">Chương Trình Đào Tạo Thực Chiến</h2>
        <p class="section-desc">
          Các chuyên đề bồi dưỡng kỹ năng lập trình nhúng, thiết kế phần cứng và tự động hóa theo lộ trình thực hành bài bản trên mạch thật.
        </p>
      </div>

      {featuredCourses.length > 0 ? (
        <div class="grid-2">
          {featuredCourses.map((course) => (
            <CourseCard course={course} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Chưa có khóa học nào được đánh dấu nổi bật.</p>
        </div>
      )}

      <div class="section-footer-cta">
        <a href="/courses" class="btn btn-secondary">
          <span>Xem danh sách tất cả các khóa học</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Social Proof: Student Outcomes & Testimonials Section -->
  <section class="section testimonials-section bg-surface-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Bảo chứng từ thực tế</span>
        <h2 class="section-title">Cảm Nhận Từ Học Viên &amp; Đối Tác</h2>
        <p class="section-desc">
          Những trải nghiệm thực tế từ các kỹ sư và đối tác đã trực tiếp học tập hoặc phối hợp triển khai dự án cùng Thầy Giang.
        </p>
      </div>

      <div class="grid-3">
        <div class="card testimonial-card">
          <div class="testimonial-stars" aria-label="5 trên 5 sao">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="testimonial-quote">
            "Trước khi học Thầy Giang, mình chỉ viết code Arduino while(1) đơn giản. Khóa học STM32 &amp; FreeRTOS giúp mình hiểu sâu về thanh ghi, DMA, quản lý tác vụ RTOS và chống Deadlock. Nhờ những kiến thức thực tế đó mà mình tự tin đỗ vị trí Embedded Software Engineer với mức đãi ngộ rất tốt."
          </p>
          <div class="testimonial-author">
            <div class="author-avatar-chip">QB</div>
            <div class="author-meta">
              <span class="author-meta-name">Nguyễn Quốc Bảo</span>
              <span class="author-meta-role">Kỹ sư Firmware IoT · TP.HCM</span>
            </div>
          </div>
        </div>

        <div class="card testimonial-card">
          <div class="testimonial-stars" aria-label="5 trên 5 sao">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="testimonial-quote">
            "Khác biệt lớn nhất ở Thầy Giang là dạy tư duy layout chống nhiễu EMC thực tế chứ không chỉ kéo dây cho nối điện. Mình áp dụng trực tiếp quy trình phân lớp đất và phối hợp trở kháng vào bo mạch gateway của công ty, đặt gia công về hàn linh kiện chạy ngay lần đầu tiên mà không bị nhiễu."
          </p>
          <div class="testimonial-author">
            <div class="author-avatar-chip accent">MH</div>
            <div class="author-meta">
              <span class="author-meta-name">Trần Minh Hoàng</span>
              <span class="author-meta-role">Trưởng nhóm R&amp;D Phần cứng</span>
            </div>
          </div>
        </div>

        <div class="card testimonial-card">
          <div class="testimonial-stars" aria-label="5 trên 5 sao">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="testimonial-quote">
            "Dự án nâng cấp hệ thống Modbus RS-485 và Scada giám sát dây chuyền do Thầy Giang trực tiếp tư vấn và lập trình đã hoạt động ổn định suốt hơn 1 năm qua trong môi trường bụi nhiệt mà không một lần treo vi điều khiển. Cực kỳ uy tín và tận tâm trong khâu chuyển giao tài liệu."
          </p>
          <div class="testimonial-author">
            <div class="author-avatar-chip emerald">VN</div>
            <div class="author-meta">
              <span class="author-meta-name">Lê Văn Nam</span>
              <span class="author-meta-role">Kỹ sư Tự Động Hóa &amp; Bảo Trì Dây Chuyền</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- YouTube Community & Social Proof Banner -->
  <section class="section yt-banner-section">
    <div class="container">
      <div class="yt-banner">
        <div class="yt-banner-badge">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="#ef4444">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#ffffff"/>
          </svg>
          <span>Kênh Chia Sẻ YouTube</span>
        </div>
        <div class="yt-banner-content">
          <h3 class="yt-banner-title">Học Lập Trình Nhúng &amp; Phân Tích Mạch Hoàn Toàn Miễn Phí</h3>
          <p class="yt-banner-desc">
            Hơn <strong>120+ video</strong> bài giảng chuyên sâu về cách debug ngoại vi STM32, xử lý nhiễu bo mạch, cấu hình ESP32 FreeRTOS và chia sẻ sơ đồ nguyên lý thực tế. Đăng ký để không bỏ lỡ video mới hàng tuần!
          </p>
        </div>
        <div class="yt-banner-action">
          <a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer" class="btn btn-youtube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#ffffff"/>
            </svg>
            <span>Đăng Ký Kênh YouTube Thầy Giang</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Góc chia sẻ kinh nghiệm</span>
        <h2 class="section-title">Bài Viết &amp; Kiến Thức Kỹ Thuật</h2>
        <p class="section-desc">
          Chia sẻ kinh nghiệm thực tế về lập trình nhúng, thiết kế bo mạch PCB, xử lý chống nhiễu EMC và ứng dụng IoT công nghiệp.
        </p>
      </div>

      {latestPosts.length > 0 ? (
        <div class="grid-3">
          {latestPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Chưa có bài viết nào được xuất bản.</p>
        </div>
      )}

      <div class="section-footer-cta">
        <a href="/blog" class="btn btn-secondary">
          <span>Xem tất cả {allPosts.length} bài viết chia sẻ</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Author Bio / About Section (Real Human & Authentic Voice) -->
  <section class="section author-section bg-surface-alt">
    <div class="container">
      <div class="author-card">
        <div class="author-avatar-wrapper">
          <img
            src="/media/author-portrait.webp"
            alt={siteConfig.authorName}
            class="author-avatar-img"
            onerror="this.src='/media/author-portrait.jpg'"
          />
        </div>
        <div class="author-info">
          <span class="badge badge-blue">Kỹ sư &amp; Giảng viên đào tạo</span>
          <h2 class="author-name">{siteConfig.authorName} <span class="author-subname">({siteConfig.brandSubname})</span></h2>
          <p class="author-title font-mono">{siteConfig.authorTitle}</p>
          <p class="author-bio-text">
