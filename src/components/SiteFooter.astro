---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Bio -->
      <div class="footer-brand-col">
        <div class="footer-brand">
          <div class="brand-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="4" width="16" height="16" rx="2" />
              <rect x="9" y="9" width="6" height="6" />
              <line x1="9" y1="1" x2="9" y2="4" />
              <line x1="15" y1="1" x2="15" y2="4" />
              <line x1="9" y1="20" x2="9" y2="23" />
              <line x1="15" y1="20" x2="15" y2="23" />
              <line x1="20" y1="9" x2="23" y2="9" />
              <line x1="20" y1="14" x2="23" y2="14" />
              <line x1="1" y1="9" x2="4" y2="9" />
              <line x1="1" y1="14" x2="4" y2="14" />
            </svg>
          </div>
          <div>
            <h3 class="footer-brand-title">{siteConfig.brandName}</h3>
            <span class="footer-brand-subtitle">{siteConfig.brandSubname}</span>
          </div>
        </div>
        <p class="footer-tagline">{siteConfig.tagline}</p>
        <p class="footer-bio">{siteConfig.authorBio}</p>
        
        <!-- Social Channels -->
        <div class="social-links">
          <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>
          <a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
          </a>
          <a href={siteConfig.socials.tiktok} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
            </svg>
          </a>
          <a href={siteConfig.socials.zalo} target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Zalo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Trang chính</h4>
        <ul class="footer-list">
          {siteConfig.navigation.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/projects" class="footer-link">Tất cả dự án</a>
          </li>
          <li>
            <a href="/courses" class="footer-link">Chương trình đào tạo</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Technical Domains -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Lĩnh vực kỹ thuật</h4>
        <ul class="footer-list">
          <li><span class="footer-text-item">Hệ thống nhúng STM32 & ESP32</span></li>
          <li><span class="footer-text-item">IoT & Giám sát dữ liệu Cloud</span></li>
          <li><span class="footer-text-item">FPGA & Ngôn ngữ Verilog HDL</span></li>
          <li><span class="footer-text-item">Thiết kế bo mạch PCB & Phần cứng</span></li>
          <li><span class="footer-text-item">PLC & Tự động hóa công nghiệp</span></li>
          <li><span class="footer-text-item">Ứng dụng Qt/C++ & Dashboard</span></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Channels -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Thông tin liên hệ</h4>
        <p class="footer-contact-item">
          <strong>Điện thoại / Zalo:</strong> {siteConfig.contact.phone}
        </p>
        <p class="footer-contact-item">
          <strong>Email:</strong> {siteConfig.contact.email}
        </p>
        <p class="footer-contact-item">
          <strong>Địa điểm:</strong> {siteConfig.contact.location}
        </p>
        <p class="footer-contact-item">
          <strong>Giờ làm việc:</strong> {siteConfig.contact.workingHours}
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} {siteConfig.brandName}. Giữ toàn quyền tác quyền và mã nguồn chia sẻ.
      </p>
      <p class="disclaimer">
        Website tĩnh phục vụ giới thiệu năng lực kỹ thuật và thông tin đào tạo thực tế.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0b1120;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.25fr 1.5fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: #1e293b;
    color: var(--color-accent-cyan);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-brand-title {
    font-size: 1.15rem;
    color: #ffffff;
    font-weight: 700;
    line-height: 1.2;
  }

  .footer-brand-subtitle {
    font-size: 0.72rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  .footer-tagline {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--color-accent-cyan);
    margin-bottom: 0.75rem;
  }

  .footer-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #94a3b8;
    margin-bottom: 1.25rem;
  }

  .social-links {
    display: flex;
    gap: 0.5rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .footer-col-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .footer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-link {
    color: #94a3b8;
    font-size: 0.9rem;
    transition: color var(--transition-fast);
    text-decoration: none;
  }

  .footer-link:hover {
    color: #38bdf8;
    padding-left: 4px;
  }

  .footer-text-item {
    font-size: 0.875rem;
    color: #94a3b8;
  }

  .footer-contact-item {
    font-size: 0.875rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .footer-contact-item strong {
    color: #cbd5e1;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    color: #64748b;
  }

  .disclaimer {
    font-size: 0.78rem;
    color: #475569;
  }
</style>
